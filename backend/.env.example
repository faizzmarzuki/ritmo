# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the SQLite file, raw provider payloads and food photos live.
# Relative paths resolve against the server/ directory.
DATA_DIR=./data

# Public origin of THIS backend. Must be reachable from the internet for
# or `ngrok http 4000` during development and paste the https URL here).
PUBLIC_URL=http://localhost:4000

# Origin of the Vite frontend (CORS + OAuth redirect target)
APP_URL=http://localhost:5173

# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
# Encrypts provider access/refresh tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENC_KEY=change-me-openssl-rand-hex-32

# ─────────────────────────────────────────────────────────────
# Set the app's "Authorization Callback Domain" to your PUBLIC_URL host.
# ─────────────────────────────────────────────────────────────
# Pull detailed HR/pace streams for each activity (1 extra API call per activity)

# ─────────────────────────────────────────────────────────────
# Garmin — official Health API (https://developer.garmin.com/health-api/)
# Requires an approved Garmin Developer Program app. OAuth 1.0a.
# Register your Push endpoint as:  ${PUBLIC_URL}/api/webhooks/garmin
# ─────────────────────────────────────────────────────────────
GARMIN_MODE=connect          # official | connect | off
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# Garmin — unofficial fallback (garmin-connect npm pkg, logs into Garmin Connect
# with your normal credentials). Works today with no partner approval, but it is
# reverse-engineered and polls instead of pushing. `npm i garmin-connect` first.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# How often to poll Garmin Connect in `connect` mode (seconds)
GARMIN_POLL_SECONDS=300

# ─────────────────────────────────────────────────────────────
# Food-photo calorie agent
# provider: openai | anthropic | google | disabled
# openai mode also covers any OpenAI-compatible gateway (OpenRouter, Groq,
# Together, LM Studio, Ollama) — just point VISION_BASE_URL at it.
# ─────────────────────────────────────────────────────────────
VISION_PROVIDER=openai
VISION_MODEL=gpt-5-mini
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
# Longest edge the photo is downscaled to before upload (needs optional `sharp`).
# Smaller = cheaper. 768 is plenty for food recognition.
VISION_MAX_EDGE=768
# Reuse a previous answer when the exact same photo is uploaded again
VISION_CACHE=true
# Fast heart-rate-only poll (seconds, min 30)
GARMIN_HR_POLL_SECONDS=60

# ══════════════════════════════════════════════════════════════
#  SPOTIFY  (now-playing + playback control)
# ══════════════════════════════════════════════════════════════
# TODO — create an app at https://developer.spotify.com/dashboard
# and add EXACTLY this Redirect URI to it:
#   http://127.0.0.1:4000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Demo mode: fake now-playing payload for UI testing without credentials
SPOTIFY_DEMO=false

# Chat coach model — always an OpenAI-compatible endpoint. Uses the per-user
# saved key, then VISION_API_KEY (openai provider), then OPENAI_API_KEY.
CHAT_MODEL=gpt-5-mini
# OpenAI key for the chat coach when VISION_PROVIDER is anthropic/google.
# With the openai provider, VISION_API_KEY already covers chat, photo analysis
# and name-only estimates (name-only estimates exist only on the openai provider).
OPENAI_API_KEY=
