{
  "name": "project-fitness-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend for Project Fitness \u2014 Garmin sync, local SQLite storage, realtime SSE, vision food-calorie agent",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
