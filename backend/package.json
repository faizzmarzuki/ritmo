{
  "name": "project-fitness-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend for Project Fitness — Garmin sync, local SQLite storage, realtime SSE, vision food-calorie agent",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "garmin:backfill": "node scripts/garmin-backfill.js",
    "agent:test": "node scripts/test-food-agent.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "optionalDependencies": {
    "garmin-connect": "^1.6.2",
    "sharp": "^0.33.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.33.5": true
  }
}
