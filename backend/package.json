    "garmin:backfill": "node scripts/garmin-backfill.js",
    "agent:test": "node scripts/test-food-agent.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "optionalDependencies": {
    "garmin-connect": "^1.6.2",
    "sharp": "^0.33.5"
  }
